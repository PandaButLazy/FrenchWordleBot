{
  "name": "french-wordle-bot",
  "version": "0.1.0",
  "description": "Bot Discord pour jouer à un Wordle personnalisé en français",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "words": "node scripts/generate-words.mjs"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "an-array-of-french-words": "^2.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
